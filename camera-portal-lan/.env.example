# Copy this file to .env only on the server. Never commit .env.
LAN_PROJECT_NAME=camera-portal-lan
LAN_CADDY_IMAGE=local/camera-portal-lan-caddy:2.11.4

LAN_BIND_IP=192.168.1.250
LAN_PORT=8088

# Docker build networking. Use host only for an explicit host proxy route.
LAN_CADDY_BUILD_NETWORK=default

# Generate with: openssl rand -hex 32
# This must be identical to camera-portal/.env.
LAN_ACCESS_KEY=replace-with-a-random-64-character-hex-value

PORTAL_INGRESS_NETWORK=camera_portal_tunnel
