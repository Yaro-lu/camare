# Copy to .env on the server. Never commit the real .env file.

# The one HTTPS origin encoded into public pairing QR codes.
PUBLIC_BASE_URL=https://camera.example.com

# Authentication-free LAN origin. It must exactly match camera-portal-lan/.env.
LOCAL_BASE_URL=http://192.168.1.250:8088

# Generate once with: openssl rand -hex 32
# Use the same value in camera-portal-lan/.env.
LAN_ACCESS_KEY=replace-with-a-random-64-character-hex-value

# Tailscale Serve administrator origin and the one allowed tailnet login.
ADMIN_ORIGIN=https://camera-server.example-tailnet.ts.net:9443
ADMIN_TAILSCALE_LOGIN=you@example.com

# Recording date boundaries and labels shown by the viewer.
RECORDING_TIMEZONE=Asia/Shanghai
CAMERAS=ptz_view=云台画面,fixed_view=枪机画面

# Host loopback ports consumed by Cloudflare/Tailscale ingress.
PUBLIC_LOOPBACK_PORT=9080
ADMIN_LOOPBACK_PORT=9081

# Docker networks created before starting this stack.
FRIGATE_DOCKER_NETWORK=frigate_default
PORTAL_INGRESS_NETWORK=camera_portal_tunnel
