# Copy to .env on the server. Never commit the real .env file.

# Camera connection. The bundled template uses two RTSP paths from one camera.
FRIGATE_CAMERA_HOST=192.168.1.128
FRIGATE_RTSP_USER=admin
FRIGATE_RTSP_PORT=554
FRIGATE_PTZ_PATH=/live/101
FRIGATE_FIXED_PATH=/live/201

# Existing writable directory for recordings. Docker will refuse to create it.
FRIGATE_MEDIA_PATH=/srv/frigate/media

# Frigate's authenticated management UI. Use a LAN or Tailscale address.
# 127.0.0.1 is the safest default when using a local reverse proxy.
FRIGATE_ADMIN_BIND_IP=127.0.0.1
FRIGATE_ADMIN_PORT=8971

# Current tested hardware preset: Intel generation 1-5 VAAPI.
FRIGATE_RENDER_DEVICE=/dev/dri/renderD128
LIBVA_DRIVER_NAME=i965

# Stable network name used by camera-portal.
FRIGATE_DOCKER_NETWORK=frigate_default

# Optional helper for cameras whose DHCP address changes.
CAMERA_MAC=00:11:22:33:44:55
CAMERA_SUBNET=192.168.1
